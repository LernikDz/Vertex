# Vertex Configuration (v1.4)
DAEMON_ENABLED=1

# Set RAM_PLUS_ENABLED=0 or RAM_PLUS_SIZE=0 to disable RAM Plus completely.
# Set RAM_PLUS_SIZE=2048 for 2GB, 4096 for 4GB, 8192 for 8GB.
RAM_PLUS_ENABLED=1
RAM_PLUS_SIZE=2048

# VM & Kernel Swappiness Tuning (Default 60 reduces swap lag)
TUNE_SWAPPINESS=1
SWAPPINESS_VALUE=60

# Flash Storage Read-Ahead (512 KB accelerates sequential reads and app opening)
TUNE_READ_AHEAD=1
READ_AHEAD_KB=512

# Crash Dump & Cache Cleanup
PURGE_CRASH_LOGS=1
TRIM_APP_CACHES=1

# Audio & Wireless Radio Stability
DISABLE_BACKGROUND_BLE_SCAN=1
DISABLE_BACKGROUND_WIFI_SCAN=1
WHITELIST_AUDIO_APPS=1

# Samsung Enhanced CPU Responsiveness (1 = Faster CPU ramp-up, 0 = Standard)
ENHANCED_CPU_RESPONSIVENESS=1

# Notifications (1 = Live NowBar/Dynamic Island notification while running + Static on finish)
SHOW_NOTIFICATIONS=1

# Kernel Memory & VFS Cache Tuning (50 prioritizes keeping directory dentries/inodes in RAM)
TUNE_VFS_CACHE=1
VFS_CACHE_PRESSURE=50

# Kernel Scheduler Context-Switch Accounting (0 disables schedstats overhead)
DISABLE_SCHED_STATS=1

# Kernel VM Stat Interval (10s reduces timer wakeups when idle/screen off)
TUNE_STAT_INTERVAL=1
STAT_INTERVAL_SEC=10

# TCP BBR Congestion Control (Low latency & high-throughput streaming)
ENABLE_TCP_BBR=1

# Bluetooth Audio Diagnostics & HCI Snoop Log (0 disables background BT log dumping)
DISABLE_BT_SNOOP_LOG=1

# Wi-Fi Sleep Policy (2 = never sleep during screen-off audio streaming)
TUNE_WIFI_SLEEP=1

# Samsung Diagnostics, AR Zone & Bloat Hibernation (Restricts background services to save battery)
RESTRICT_SAMSUNG_TELEMETRY=1
DEEP_BLOAT_HIBERNATION=1

# Audio & Bluetooth Real-Time Scheduling (nice -16 + top-app cpuset to prevent L/R earbud desync)
BOOST_AUDIO_PRIORITY=1

# Prevent Screen Lock Audio Stutter (Disables lockscreen sound effect to eliminate AudioFlinger stream collision)
PREVENT_LOCKSCREEN_AUDIO_STUTTER=1

# ZRAM Compression Algorithm Engine (zstd = ~35% higher compression ratio, lz4 = low CPU, lzo-rle = default)
TUNE_ZRAM_ALGORITHM=1
ZRAM_COMP_ALGORITHM=zstd

# Display Smooth Scroll Lock (1 = Force 120Hz minimum refresh rate, 0 = Stock dynamic LTPO 1-120Hz)
FORCE_120HZ_REFRESH=0

# Bypass Charging (1 = Power phone directly from charger without battery charging)
BYPASS_CHARGING_ENABLED=0

# Smart Screen-Off / Idle Aware Daemon (1 = wait until screen is off/idle before running 5 AM pass)
SMART_SCREEN_AWARE=1

# Vulkan Skia UI Renderer & SurfaceFlinger Zero-Latency Latching (1 = SkiaVK + unsignaled frame latch)
VULKAN_UI_ENABLED=1
SF_ZERO_LATENCY_LATCHING=1

# UFS 4.0 Storage I/O Scheduler & Queue Tuning (Sets zero-overhead scheduler 'none' or 'mq-deadline')
TUNE_UFS_SCHEDULER=1

# SQLite Database Defragmentation & Vacuum (Clean fragmented app databases during daily pass)
SQLITE_VACUUM_ENABLED=1

# Touch Digitizer Sensitivity & InputDispatcher Real-Time Boost (240Hz High Sampling Rate)
TOUCH_BOOST_ENABLED=1

# Force Classic Bluetooth A2DP & Disable LE Audio (Fixes audio cuts/stutters on Galaxy Buds)
DISABLE_LE_AUDIO=1
